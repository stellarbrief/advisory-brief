# Set ONE of these two. Anthropic is used first if both are set.
ANTHROPIC_API_KEY=
# Optional. Defaults to claude-sonnet-5 if unset.
ANTHROPIC_MODEL=

# Free-tier alternative -- get a key at https://aistudio.google.com, no card required.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.1-flash-lite if unset -- confirmed live to handle real
# structured-output (JSON schema) requests; gemini-flash-latest returned a real 503 for
# JSON-mode specifically at the time this was tested. See src/brief/providers/gemini.ts.
GEMINI_MODEL=

# Optional. Raises GitHub's unauthenticated 60-req/hour rate limit for the GitHub Releases
# source. A plain public-repo read token is enough; no scopes are required.
GITHUB_TOKEN=

# Optional. `/api/brief` is limited to this many requests per client address per window; the
# values shown are the defaults when the variables are absent. The counter is in-process memory
# and trusts X-Forwarded-For from your proxy -- see the README's Deployment note before exposing
# an instance publicly.
BRIEF_RATE_LIMIT_REQUESTS=10
BRIEF_RATE_LIMIT_WINDOW_SECONDS=60
